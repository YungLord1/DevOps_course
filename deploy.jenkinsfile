@Library('shared-library') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }
    environment {
        DOCKER_HOST = "unix:///run/podman/podman.sock"
        RELEASE_NAME = "currency-app"
        CHART_PATH   = "helm/currency-app"
        APP_URL      = "https://chach.industry.com"
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'image tag')
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'])
    }

    stages {
        stage('Deploy with Helm') {
            steps {
                script {
                    def isStaging = (params.ENVIRONMENT == 'staging')
                    def currentStage = isStaging ? 'Deploy to Staging' : 'Deploy to Production'

                    conditionalStage(name: currentStage, condition: true) {
                        checkout scm

                        withCredentials([
                            file(credentialsId: 'APP_TLS_CRT', variable: 'TLS_CRT_FILE'),
                            file(credentialsId: 'APP_TLS_KEY', variable: 'TLS_KEY_FILE'),
                            usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'U', passwordVariable: 'P')
                        ]) {
                            echo "Log Docker Hub as: ${U}"
                            sh "echo ${P} | podman login -u ${U} --password-stdin"

                            def fullImageName = params.IMAGE_TAG.contains('/') ?
                                                params.IMAGE_TAG :
                                                "${U}/currency_app:${params.IMAGE_TAG}"

                            sh "cp ${TLS_CRT_FILE} ${env.CHART_PATH}/tls.crt"
                            sh "cp ${TLS_KEY_FILE} ${env.CHART_PATH}/tls.key"

                            echo "Starting Helm upgrade for: ${fullImageName}"

                            def repo = fullImageName.split(':')[0]
                            def tag = fullImageName.split(':')[1]

                            sh """
                            helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_PATH} \
                                --namespace ${params.ENVIRONMENT} \
                                --create-namespace \
                                --set image.repository=${repo} \
                                --set image.tag=${tag} \
                                --wait --timeout 5m --atomic
                            """
                        }
                    }
                }
            }
        }

        stage('Smoke tests + DAST') {
            steps {
                script {
                    echo "Waiting for pods to be ready..."
                    parallel(
                        'Smoke tests': {
                            stage('Smoke tests') {
                                sh '''
                                    python3 -m venv venv
                                    ./venv/bin/pip install -r requirements.txt
                                    ./venv/bin/python3 -m pytest tests/test_currency_app.py --junitxml=smoke_report.xml
                                '''
                                sh "curl -f ${env.APP_URL}/info || exit 1"
                            }
                        },
                        'DAST': {
                            stage('DAST') {
                                testsLint.runDAST(env.APP_URL)
                            }
                        }
                    )
                }
            }
            post {
                always {
                    junit 'smoke_report.xml'
                    archiveArtifacts artifacts: 'smoke_report.xml, zap_report.xml', allowEmptyArchive: true
                }
            }
        }

        stage('Manual Approval (Production Only)') {
            when {
                expression { params.ENVIRONMENT == 'production' }
            }
            steps {
                script {
                    echo "Checking deployment on ${env.APP_URL}"
                    input message: "Does the Production deployment look good?", ok: "Approve"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "DEPLOYMENT FAILED! Rolling back to previous stable version..."
                sh "helm rollback ${env.RELEASE_NAME} 0 --namespace ${params.ENVIRONMENT} || echo 'Rollback failed'"
            }
        }
        always {
            sh "rm -f ${env.CHART_PATH}/tls.crt ${env.CHART_PATH}/tls.key || true"
            sh 'podman system prune -f'
            cleanWs()
        }
    }
}

@Library('shared-library') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }
    environment {
        DOCKER_HOST = "unix:///var/run/docker.sock"
        RELEASE_NAME = "currency-app"
        CHART_PATH = "helm/currency-app"
        KUBECONFIG = "${WORKSPACE}/kubeconfig.conf"
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'image tag')
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'])
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Helm') {
            steps {
                sh '''
                    if ! /tmp/helm version &> /dev/null; then
                        echo "Installing Helm to /tmp..."
                        curl -fsSL -o /tmp/get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
                        chmod 700 /tmp/get_helm.sh
                        HELM_INSTALL_DIR=/tmp USE_SUDO=false /tmp/get_helm.sh --no-sudo || true
                        chmod +x /tmp/helm
                    fi
                    /tmp/helm version
                '''
            }
        }

        stage('Deploy') {
            steps {
                script {
                    withCredentials([
                        file(credentialsId: 'KUBECONFIG', variable: 'KUBE_CONFIG_FILE'),
                        usernamePassword(credentialsId: 'dockerhub_creds',
                                         usernameVariable: 'DOCKER_USER',
                                         passwordVariable: 'DOCKER_PASS')
                    ]) {
                        sh "cp ${KUBE_CONFIG_FILE} ${WORKSPACE}/kubeconfig.conf"
                        sh "chmod 600 ${WORKSPACE}/kubeconfig.conf"

                        def cleanTag = params.IMAGE_TAG.contains(':')
                            ? params.IMAGE_TAG.split(':')[-1]
                            : params.IMAGE_TAG
                        def repository = "${DOCKER_USER}/currency_app"

                        sh """
                            export KUBECONFIG=${WORKSPACE}/kubeconfig.conf

                            kubectl create namespace ${params.ENVIRONMENT} \
                                --dry-run=client -o yaml | kubectl apply -f -

                            kubectl create secret docker-registry regcred \
                                --docker-server=https://index.docker.io/v1/ \
                                --docker-username=${DOCKER_USER} \
                                --docker-password=${DOCKER_PASS} \
                                --namespace ${params.ENVIRONMENT} \
                                --dry-run=client -o yaml | kubectl apply -f -

                            echo "Deploying ${repository}:${cleanTag} to ${params.ENVIRONMENT}..."

                            /tmp/helm upgrade --install ${RELEASE_NAME} ${CHART_PATH} \
                                --namespace ${params.ENVIRONMENT} \
                                --set image.repository=${repository} \
                                --set image.tag=${cleanTag} \
                                --set namespace=${params.ENVIRONMENT} \
                                --wait \
                                --timeout 5m \
                                --atomic
                        """
                    }
                }
            }
        }

        stage('Smoke test') {
            steps {
                script {
                    sh "pkill -f 'port-forward svc/myapp-service' || true"

                    sh """
                        export KUBECONFIG=${WORKSPACE}/kubeconfig.conf
                        echo "Using kubeconfig: \$KUBECONFIG"
                        kubectl get pods -n ${params.ENVIRONMENT}
                    """

                    echo "Smoke-tests"
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/pip install -r requirements.txt -q
                        APP_URL=http://myapp-service.staging.svc.cluster.local:8000 ./venv/bin/python3 -m pytest \
                            tests/test_currency_app.py \
                            --junitxml=smoke_report.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'smoke_report.xml'
                    archiveArtifacts artifacts: 'smoke_report.xml', allowEmptyArchive: true
                }
            }
        }

        stage('DAST') {
            steps {
                script {
                    echo "DAST (OWASP ZAP)"
                    testsLint.runDAST("http://myapp-service.staging.svc.cluster.local:8000/info")
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap_report.xml', allowEmptyArchive: true
                }
            }
        }

        stage('Approve (Production Only)') {
            when {
                expression { params.ENVIRONMENT == 'production' }
            }
            steps {
                input message: "Deploy to production. Approve?", ok: "Approve"
            }
        }
    }

    post {
        failure {
            script {
                sh """
                    export KUBECONFIG=${WORKSPACE}/kubeconfig.conf
                    /tmp/helm rollback ${RELEASE_NAME} 0 \
                        --namespace ${params.ENVIRONMENT} \
                        --wait || echo 'Rollback failed or no previous release'
                """
            }
        }
        always {
            sh "rm -f ${WORKSPACE}/kubeconfig.conf || true"
            sh 'podman system prune -f || true'
            cleanWs()
        }
    }
}
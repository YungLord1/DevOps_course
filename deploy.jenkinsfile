@Library('shared-library') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }
    environment {
        DOCKER_HOST = "unix:///run/podman/podman.sock"
        RELEASE_NAME = "currency-app"
        CHART_PATH   = "helm/currency-app"
        APP_URL      = "https://chach.industry.com"
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'image tag')
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'])
    }

    stages {
        stage('Install Helm 4 & Deploy') {
            steps {
                script {
                    sh '''
                        echo "Installing Helm 4 to /tmp..."
                        curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-4
                        chmod 700 get_helm.sh
                        export HELM_INSTALL_DIR=/tmp
                        USE_SUDO=false ./get_helm.sh --no-sudo || true
                        chmod +x /tmp/helm
                        /tmp/helm version
                    '''

                    withCredentials([
                        file(credentialsId: 'KUBECONFIG', variable: 'KUBE_CONFIG_FILE'),
                        file(credentialsId: 'APP_TLS_CRT', variable: 'TLS_CRT_FILE'),
                        file(credentialsId: 'APP_TLS_KEY', variable: 'TLS_KEY_FILE'),
                        usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
                    ]) {
                        def cleanTag = params.IMAGE_TAG.contains(':') ? params.IMAGE_TAG.split(':')[-1] : params.IMAGE_TAG
                        def repository = "${DOCKER_USER}/currency_app"

                        sh """
                            export KUBECONFIG=${KUBE_CONFIG_FILE}

                            cp ${TLS_CRT_FILE} helm/currency-app/tls.crt
                            cp ${TLS_KEY_FILE} helm/currency-app/tls.key

                            kubectl create namespace ${params.ENVIRONMENT} --dry-run=client -o yaml | kubectl apply -f -

                            kubectl create secret docker-registry regcred \
                                --docker-server=https://index.docker.io/v1/ \
                                --docker-username=${DOCKER_USER} \
                                --docker-password=${DOCKER_PASS} \
                                --namespace ${params.ENVIRONMENT} \
                                --dry-run=client -o yaml | kubectl apply -f -

                            echo "Deploying ${repository}:${cleanTag} to ${params.ENVIRONMENT} namespace..."

                            /tmp/helm upgrade --install currency-app helm/currency-app \
                                --namespace ${params.ENVIRONMENT} \
                                --set image.repository=${repository} \
                                --set image.tag=${cleanTag} \
                                --wait \
                                --timeout 5m \
                                --rollback-on-failure
                        """
                    }
                }
            }
        }

        stage('Smoke tests + DAST') {
            steps {
                script {
                    echo "Waiting for pods to be ready..."
                    parallel(
                        'Smoke tests': {
                            stage('Smoke tests') {
                                sh '''
                                    python3 -m venv venv
                                    ./venv/bin/pip install -r requirements.txt
                                    ./venv/bin/python3 -m pytest tests/test_currency_app.py --junitxml=smoke_report.xml
                                '''
                                sh "curl -f ${env.APP_URL}/info || exit 1"
                            }
                        },
                        'DAST': {
                            stage('DAST') {
                                testsLint.runDAST(env.APP_URL)
                            }
                        }
                    )
                }
            }
            post {
                always {
                    junit 'smoke_report.xml'
                    archiveArtifacts artifacts: 'smoke_report.xml, zap_report.xml', allowEmptyArchive: true
                }
            }
        }

        stage('Manual Approval (Production Only)') {
            when {
                expression { params.ENVIRONMENT == 'production' }
            }
            steps {
                script {
                    echo "Checking deployment on ${env.APP_URL}"
                    input message: "Does the Production deployment look good?", ok: "Approve"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "DEPLOYMENT FAILED! Rolling back to previous stable version..."
                sh "helm rollback ${env.RELEASE_NAME} 0 --namespace ${params.ENVIRONMENT} || echo 'Rollback failed'"
            }
        }
        always {
            sh "rm -f ${env.CHART_PATH}/tls.crt ${env.CHART_PATH}/tls.key || true"
            sh 'podman system prune -f'
            cleanWs()
        }
    }
}

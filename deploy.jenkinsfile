@Library('shared-library') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }
    environment {
        DOCKER_HOST = "unix:///run/podman/podman.sock"
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'image tag')
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'])
    }

    stages {
        stage('Deploy Green') {
            steps {
                script {
                    def isStaging = (params.ENVIRONMENT == 'staging')
                    def currentStage = isStaging ? 'Deploy to Staging' : 'Deploy to Production'

                    conditionalStage(name: currentStage, condition: true) {
                        checkout scm

                        withCredentials([
                            file(credentialsId: 'ENV_FILE', variable: 'SECRET_FILE_PATH'),
                            usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'U', passwordVariable: 'P')
                        ]) {
                            echo "Log Docker Hub as: ${U}"
                            sh "echo ${P} | podman login -u ${U} --password-stdin"
                            def fullImageName = params.IMAGE_TAG.contains('/') ? 
                                                params.IMAGE_TAG : 
                                                "${U}/currency_app:${params.IMAGE_TAG}"

                            echo "Starting green version: ${fullImageName} on 8001"

                            withEnv(["FULL_IMAGE=${fullImageName}", "S_PATH=${SECRET_FILE_PATH}"]) {
                                sh 'IMAGE_NAME=${FULL_IMAGE} APP_PORT=8001 podman compose -p app-green --env-file ${S_PATH} up -d'
                            }
                        }
                    }
                }
            }
        }

        stage('Smoke tests + DAST') {
            steps {
                script {
                    echo "Waiting for Green..."
                    sleep 5
                    parallel(
                        'Smoke tests': {
                            stage('Smoke tests') {
                                echo "Running tests..."
                                sh '''
                                    python3 -m venv venv
                                    ./venv/bin/pip install -r requirements.txt
                                    ./venv/bin/python3 -m pytest tests/test_currency_app.py --junitxml=smoke_report.xml
                                '''
                                sh "curl -f http://localhost:8001/info || exit 1"
                            }
                        },
                        'DAST': {
                            stage('DAST') {
                                testsLint.runDAST("http://localhost:8001")
                            }
                        }
                    )
                }
            }
            post {
                always {
                    junit 'smoke_report.xml'
                    archiveArtifacts artifacts: 'smoke_report.xml, zap_report.xml', allowEmptyArchive: true
                    echo 'Atrifacts collected'
                }
            }
        }

        stage('Switch Green to Blue') {
            steps {
                script {
                    def fullImageName = params.IMAGE_TAG.contains('/') ?
                    params.IMAGE_TAG :
                    "${U}/currency_app:${params.IMAGE_TAG}"
                    withCredentials([
                        file(credentialsId: 'ENV_FILE', variable: 'SECRET_FILE_PATH'),
                        usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'U', passwordVariable: 'P')
                    ]) {
                        echo "Stopping old Blue"
                        sh 'podman compose -p app-blue down || true'

                        echo "Starting new Blue ${fullImageName}"
                        withEnv(["FULL_IMAGE=${fullImageName}", "S_PATH=${SECRET_FILE_PATH}"]) {
                            sh 'IMAGE_NAME=${FULL_IMAGE} APP_PORT=8000 podman compose -p app-blue --env-file ${S_PATH} up -d'
                        }

                        echo "Cleaning green..."
                        sh 'podman compose -p app-green down || true'
                    }
                }
            }
        }
    }
    post {
        failure {
            echo "DEPLOYMENT FAILED! Cleaning up green"
            sh "podman compose -p app-green down || true"
        }
        always {
            sh 'podman system prune -f'
            cleanWs()
        }
    }
}

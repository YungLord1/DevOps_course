@Library('shared-library') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'image tag')
        choice(name: 'ENVIRONMENT', choices: ['staging', 'production'])
    }

    stages {
        stage('Deploy Green') {
            steps {
                script {
                    def isStaging = (params.ENVIRONMENT == 'staging')
                    def currentStage = isStaging ? 'Deploy to Staging' : 'Deploy to Production'

                    conditionalStage(name: currentStage, condition: true) {
                        checkout scm

                        withCredentials([
                            file(credentialsId: 'ENV_FILE', variable: 'SECRET_FILE_PATH'),
                            usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'U', passwordVariable: 'P')
                        ]) {
                            echo "Logging into Docker Hub as: ${U}"
                            sh "echo ${P} | docker login -u ${U} --password-stdin"
                            def fullImageName = params.IMAGE_TAG.contains('/') ? 
                                                params.IMAGE_TAG : 
                                                "${U}/currency_app:${params.IMAGE_TAG}"

                            echo "Starting green version: ${fullImageName} on port 8001"

                            withEnv(["FULL_IMAGE=${fullImageName}", "S_PATH=${SECRET_FILE_PATH}"]) {
                                sh 'IMAGE_NAME=${FULL_IMAGE} APP_PORT=8001 docker compose -p app-green --env-file ${S_PATH} up -d'
                            }
                        }
                    }
                }
            }
        }

        stage('Smoke tests') {
            steps {
                script {
                    echo "Waiting for Green slot to start..."
                    sleep 5

                    echo "Running tests against port 8001..."
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/pip install -r requirements.txt
                        ./venv/bin/python3 -m pytest tests/test_currency_app.py --junitxml=smoke_report.xml
                    '''

                    sh "curl -f http://localhost:8001/info || exit 1"
                }
            }
            post {
                always {
                    junit 'smoke_report.xml'
                    archiveArtifacts artifacts: 'smoke_report.xml', fingerprint: true
                    echo 'Atrifacts collected'
                }
            }
        }

        stage('Switch Green to Blue') {
            steps {
                script {
                    def fullImageName = params.IMAGE_TAG.contains('/') ?
                                        params.IMAGE_TAG : 
                                        "${U}/currency_app:${params.IMAGE_TAG}"

                    echo "Switching Blue slot to new version: ${fullImageName} on port 8000"

                    withCredentials([
                        file(credentialsId: 'ENV_FILE', variable: 'SECRET_FILE_PATH'),
                        usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'U', passwordVariable: 'P')
                    ]) {
                        withEnv(["FULL_IMAGE=${fullImageName}", "S_PATH=${SECRET_FILE_PATH}"]) {
                            sh 'IMAGE_NAME=${FULL_IMAGE} APP_PORT=8000 docker compose -p app-blue --env-file ${S_PATH} up -d'
                        }
                        echo "Stopping Green slot..."
                        sh 'docker compose -p app-green down || true'
                    }
                }
            }
        }

    post {
        failure {
            echo "DEPLOYMENT FAILED! Cleaning up Green slot, Blue remains untouched."
            sh "docker compose -p app-green down || true"
        }
        always {
            sh 'docker system prune -f'
            cleanWs()
        }
    }
}
